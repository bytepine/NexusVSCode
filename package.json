{
  "name": "nexus-mcp-vscode",
  "displayName": "Nexus MCP",
  "description": "MCP proxy for VS Code / Cursor: auto-discovers UE instances and exposes NexusLink tools to AI clients",
  "version": "0.0.0",
  "publisher": "byteyang",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytepine/NexusVSCode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "unreal engine",
    "unreal",
    "ue",
    "mcp",
    "model context protocol",
    "ai",
    "cursor",
    "game development"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nexus MCP",
      "properties": {
        "nexusMcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用 Nexus MCP 代理服务器"
        },
        "nexusMcp.httpPort": {
          "type": "number",
          "default": 6900,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Streamable HTTP MCP 服务端口（AI 客户端通过此端口连接）"
        },
        "nexusMcp.scanPortStart": {
          "type": "number",
          "default": 45000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "UE 实例扫描起始端口"
        },
        "nexusMcp.scanPortEnd": {
          "type": "number",
          "default": 45100,
          "minimum": 1024,
          "maximum": 65535,
          "description": "UE 实例扫描结束端口"
        },
        "nexusMcp.scanIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 3600,
          "description": "UE 实例自动扫描间隔（秒）"
        },
        "nexusMcp.logLevel": {
          "type": "string",
          "enum": ["info", "debug"],
          "default": "info",
          "description": "输出面板日志级别；debug 额外显示排查用细节（如代理层反馈上报降级）"
        },
        "nexusMcp.writeGate": {
          "type": "string",
          "enum": ["off", "destructive", "all"],
          "default": "destructive",
          "description": "写操作门控：off 不确认；destructive（默认）删除/重命名/停 PIE/manage 删除类 op；all 所有写操作。确认框可选允许 / 拒绝 / 本会话总是允许。"
        },
        "nexusMcp.listenLan": {
          "type": "boolean",
          "default": false,
          "description": "MCP HTTP 绑 0.0.0.0，允许局域网 AI 客户端连接（默认须 Bearer，可关鉴权；勿映射到公网）"
        },
        "nexusMcp.requireAuth": {
          "type": "boolean",
          "default": true,
          "description": "AI 连接本代理是否校验 Bearer。默认开；关闭后与旧版代理相同（无需 Authorization）。连 UE 仍按对方 /status.authRequired"
        },
        "nexusMcp.extraAuthTokens": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "额外鉴权 token（其他机器，每项一个或逗号分隔）。AI Bearer 命中任一项即可；连远程 UE 时也可作候选。本机 UE 自动读 mcp-auth-token，无需填写"
        },
        "nexusMcp.remoteUnreal": {
          "type": "array",
          "default": [],
          "description": "远程 UE 显式列表（不扫网段）。每项 host + mcpPort；authToken 可选（可逗号分隔多个）。本机 UE 无需配置",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string", "description": "UE 机器局域网 IP" },
              "mcpPort": { "type": "number", "description": "NexusLink MCP HTTP 端口" },
              "authToken": { "type": "string", "description": "该 UE 的 token，可逗号分隔多个；留空则用 extraAuthTokens" }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "nexus.refreshInstances",
        "title": "Nexus MCP: 刷新 UE 实例"
      },
      {
        "command": "nexus.selectInstance",
        "title": "Nexus MCP: 选择 UE 实例"
      },
      {
        "command": "nexus.disconnect",
        "title": "Nexus MCP: 断开 UE 连接"
      },
      {
        "command": "nexus.copyMcpConfig",
        "title": "Nexus MCP: 复制 MCP 客户端配置"
      },
      {
        "command": "nexus.copyAuthToken",
        "title": "Nexus MCP: 复制鉴权 Token"
      },
      {
        "command": "nexus.pauseAgent",
        "title": "Nexus MCP: 暂停 Agent 转发"
      },
      {
        "command": "nexus.resumeAgent",
        "title": "Nexus MCP: 恢复 Agent 转发"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "vsce package",
    "lint": "eslint src/",
    "test:policy": "esbuild src/proxy/index.ts --bundle --outfile=dist/sessionHub.cjs --format=cjs --platform=node && node scripts/test-session-policy.cjs"
  },
  "dependencies": {
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.14",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.4",
    "typescript": "~5.7.3"
  }
}
